# =============================================================
#  SCA 3사 비교 설정
# =============================================================

# ---------- [위치] 여기만 바꾸면 됨 ----------
# [필수]
IP=

# [필수] 스캔/비교 할 로컬 소스 경로
SCAN_PATH=

# [선택] 프로젝트 키. 비워두면 <오늘날짜>_<SCAN_PATH 마지막 폴더명> 자동 생성
PROJECT_KEY=


# =============================== 스패로우 [필수] ===============================
USERNAME1=
PASSWORD1=
# 같은 서버가 두 포트로 열려 있음: 조회(GraphQL)=http:10610 / CLI=https:10880
PORT=10610
SPARROW_SCHEME=http
SPARROW_CLI_SERVER=https://${IP}:10880
# 스패로우 client 설치 경로
SPARROW_CLI_PATH=
SPARROW_AUTO_SCAN=true
SPARROW_PROFILE=컴포넌트 분석 검출 규칙
SPARROW_ANALYSIS_TYPE=full
# 비우면 전체 확장자
SPARROW_EXTENSIONS=
# analysis=분석 끝나면 반환(빠름) | project=결과 반영까지 대기(서버 지연 시 오래 걸림)
SPARROW_SYNC_MODE=analysis
SPARROW_SCAN_TIMEOUT=3600
# 자산경로 수집: 컴포넌트당 쿼리 1회라 느리면 false
SPARROW_FETCH_PATHS=true
SPARROW_PATH_WORKERS=8
# 스캔 직후 0건이면 재조회 (반영 지연 안전망)
SPARROW_RETRY_COUNT=12
SPARROW_RETRY_WAIT=15

# =============================== 블랙덕 [필수] ===============================
# 블랙덕 프로젝트 이름. 비우면 PROJECT_KEY 와 같은 값
BLACKDUCK_PROJECT_KEY=
BLACKDUCK_URL=
BLACKDUCK_API_TOKEN=
BLACKDUCK_FETCH_PATHS=true
BLACKDUCK_AUTO_SCAN=true
# 블랙덕 detect 전용 .jar파일 설치 경로
BLACKDUCK_DETECT_JAR=
# 실행마다 'auto-YYYYMMDD-HHMMSS' 새 버전 생성 (기존 BOM 보존)
BLACKDUCK_VERSION_AUTO=true
BLACKDUCK_VERSION_PREFIX=auto
# 고정 버전을 쓰려면 위를 false 로 하고 아래에 이름을 적을 것
# BLACKDUCK_PROJECT_VERSION=
# 매니페스트 탐색 깊이 (0=지정 폴더만. 중첩 폴더 구조라 넉넉히)
BLACKDUCK_SEARCH_DEPTH=10
BLACKDUCK_ACCURACY=NONE
# 비우면 Detect 기본(DETECTOR+SIGNATURE_SCAN). 매니페스트만 보려면 DETECTOR
BLACKDUCK_DETECT_TOOLS=
BLACKDUCK_SCAN_TIMEOUT=3600

# =============================== Snyk [필수] ===============================
SNYK_TOKEN=
SNYK_ORG_ID=
SNYK_API_URL=https://api.snyk.io
SNYK_API_VERSION=2024-10-15
# devDependencies 포함 여부. false 면 검출 수가 크게 줄어드니 주의
SNYK_DEV_DEPS=true
